---
interface Props {
	animationData: { w: number; h: number; [key: string]: unknown };
	loop?: boolean;
	autoplay?: boolean;
	/** Any CSS length, or a number in px. Width scales down to keep the aspect ratio. */
	maxHeight?: number | string;
	label?: string;
	class?: string;
}

const { animationData, loop = true, autoplay = true, maxHeight, label, class: className } = Astro.props;

const ratio = `${animationData.w} / ${animationData.h}`;
const maxHeightValue = typeof maxHeight === 'number' ? `${maxHeight}px` : maxHeight;
const style = [
	`aspect-ratio: ${ratio};`,
	maxHeightValue && `max-width: calc(${maxHeightValue} * ${ratio});`,
]
	.filter(Boolean)
	.join(' ');
---

<div
	class:list={['lottie', className]}
	style={style}
	data-lottie={JSON.stringify(animationData)}
	data-loop={String(loop)}
	data-autoplay={String(autoplay)}
	role={label ? 'img' : undefined}
	aria-label={label}
	aria-hidden={label ? undefined : 'true'}
>
</div>

<script>
	import lottie from 'lottie-web/build/player/lottie_light';

	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	document.querySelectorAll<HTMLElement>('[data-lottie]').forEach((container) => {
		const animation = lottie.loadAnimation({
			container,
			renderer: 'svg',
			loop: container.dataset.loop === 'true',
			autoplay: container.dataset.autoplay === 'true' && !reduceMotion,
			animationData: JSON.parse(container.dataset.lottie!),
		});
		container.removeAttribute('data-lottie');

		// Show the first frame as a still image when motion is reduced
		if (reduceMotion) animation.goToAndStop(0, true);
	});
</script>

<style>
	.lottie {
		width: 100%;
	}
</style>
